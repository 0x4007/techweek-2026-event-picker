on makeDate(dayValue, hourValue, minuteValue)
	set d to current date
	set year of d to 2026
	set month of d to June
	set day of d to dayValue
	set time of d to (hourValue * hours + minuteValue * minutes)
	return d
end makeDate

on isManagedTechWeekEvent(theEvent)
	set eventSummary to ""
	set eventDescription to ""
	set eventUID to ""
	tell application "Calendar"
		try
			set eventSummary to summary of theEvent as text
		end try
		try
			set eventDescription to description of theEvent as text
		end try
		try
			set eventUID to uid of theEvent as text
		end try
	end tell
	if eventUID contains "techweek-2026-event-picker" then return true
	if eventSummary starts with "[TW-" then return true
	if eventDescription contains "CalendarBlockID: TW-" then return true
	if eventDescription contains "TechWeekID: TW-" then return true
	if eventSummary starts with "Tech Week:" and eventDescription contains "partiful.com" then return true
	if eventSummary starts with "Apply:" and eventDescription contains "partiful.com" then return true
	if eventSummary starts with "Backup:" and eventDescription contains "partiful.com" then return true
	if eventSummary starts with "Travel:" and eventDescription contains "Rank/tier/score:" then return true
	return false
end isManagedTechWeekEvent

on deleteManagedTechWeekEvents(targetCal, windowStart, windowEnd)
	tell application "Calendar"
		set existingEvents to every event of targetCal whose start date is greater than or equal to windowStart and start date is less than windowEnd
		repeat with existingEvent in existingEvents
			if my isManagedTechWeekEvent(existingEvent) then delete existingEvent
		end repeat
	end tell
end deleteManagedTechWeekEvents

with timeout of 900 seconds
tell application "Calendar"
	set scheduleName to "NY Tech Week 2026 - Schedule"
	set referenceName to "NY Tech Week 2026 - All RSVPs"
	if not (exists calendar scheduleName) then make new calendar with properties {name:scheduleName}
	if not (exists calendar referenceName) then make new calendar with properties {name:referenceName}
	set scheduleCal to calendar scheduleName
	set referenceCal to calendar referenceName
	set windowStart to my makeDate(1, 0, 0)
	set windowEnd to my makeDate(8, 0, 0)
	my deleteManagedTechWeekEvents(scheduleCal, windowStart, windowEnd)
	my deleteManagedTechWeekEvents(referenceCal, windowStart, windowEnd)

	-- Operational route with transit blocks.
